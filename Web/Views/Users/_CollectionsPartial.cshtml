@model IEnumerable<ProductCollectionDTO>

<ul class="row p-0">        
    @foreach (var item in Model)
    {
        <li class="col-md-3 mb-4 list-unstyled">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                {
                    <a asp-action="Details" asp-controller="Product" asp-route-id="@item.ProductID">
                        <img src="/images/@item.Product.ImageUrl" class="card-img-top" alt="@item.Product.ProductName">
                    </a>
                }
                else
                {
                    <div class="card-img-top bg-light text-center py-5">
                        <i class="fas fa-image fa-3x text-muted"></i>
                    </div>
                }
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <a asp-action="Details" asp-controller="Product" asp-route-id="@item.ProductID" class="card-title text-decoration-none fs-5">@item.Product.ProductName</a>
                        <p class="card-text">
                            @if (item.Product.UnitPrice.HasValue)
                            {
                                <span class="text-danger">NT$ @item.Product.UnitPrice.Value.ToString("N0")</span>
                            }
                        </p>
                    </div>
                    <div class="cancel-collect-btn" data-product-id="@item.ProductID">
                        取消收藏
                    </div>
                </div>
            </div>
        </li>
    }
</ul>
