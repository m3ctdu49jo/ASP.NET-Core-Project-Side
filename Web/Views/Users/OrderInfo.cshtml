@model UsersOrderInfoViewModel

@{
    ViewData["Title"] = "」訂單紀錄";
    var order = Model.OrderDTO;
}

@section Styles {
    <style>
        .order-item {
            transition: all 0.2s ease-in-out
        }

        .order-item:hover {
            box-shadow: 0 5px 15px 0px rgba(0, 0, 0, 0.15);
        }
    </style>
}
<div class="row">
    <div class="col-md-2">
        @await Html.PartialAsync("Users/_UserCenterSubMenuPartial")
    </div>
    <div class="col-md-10">
        @await Html.PartialAsync("Ordinary/_TitlePartial", ViewData["Title"])
        <div class="d-flex flex-warp">
            <div class="d-block w-100 mb-3 fs-5">訂單編號：<font class="text-green">@order.OrderNum</font>
            </div>
            <div class="d-block w-100 mb-3 text-end">購買日期：@($"{order.OrderDate:yyyy/MM/dd}")</div>
        </div>
        <div class="bg-white p-4 mb-5">
            @foreach (var item in Model.OrderDetailDTOs)
            {

                <div class="d-flex justify-content-between pb-3 mb-3 border-bottom">
                    <div class="d-flex">
                        <div class="me-3" style="width: 100px;height: 80px">
                            <img class="object-fit-cover object-position-50-50 w-100 h-100"
                                 src="~/@item.Product.ImageUrl" />
                        </div>
                        <div class="d-flex flex-column ">
                            <div class="w-100 mb-3">@item.Product.ProductName</div>
                            <div>

                                <div class="me-3 fs-7">數量：@item.Quantity</div>
                                <div class="me-3 fs-7">單價：<span class="text-danger">$@($"{item.UnitPrice:#,###.00}")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                
                </div>
            }
            <div class="text-end">
                總計：<span class="text-danger">$@($"{Model.OrderDetailDTOs.Sum(m => m.Quantity * m.UnitPrice):#,###.00}")</span></div>
            </div>

            <div class="d-flex flex-warp">
                <div class="d-block w-100 mb-3 fs-5">配送訊息</div>
            </div>
            <div class="d-flex flex-column gap-3 bg-white p-4">
                <div><span class="text-grey-aaa">收件人：</span>@order.ShipName</div>
                <div><span class="text-grey-aaa">收件地址：</span>@order.ShipAddress</div>
                <div><span class="text-grey-aaa">聯絡電話：</span>@order.ShipPhone</div>
                <div><span class="text-grey-aaa">付款方式：</span>@Model.PaymentName</div>
                <div><span class="text-grey-aaa">訂單狀態：</span>@Model.StatusName</div>
            </div>
        </div>
    </div>
