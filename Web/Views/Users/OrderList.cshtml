@model IEnumerable<OrderInfo>

@{
    ViewData["Title"] = "」訂單紀錄";
}

@section Styles {
    <style>
        .order-item {
            transition: all 0.2s ease-in-out
        }

        .order-item:hover {
            box-shadow: 0 5px 15px 0px rgba(0, 0, 0, 0.15);
        }
    </style>
}
<div class="row">
    <div class="col-md-2">
        @await Html.PartialAsync("Users/_UserCenterSubMenuPartial")
    </div>
    <div class="col-md-10">
        @await Html.PartialAsync("Ordinary/_TitlePartial", ViewData["Title"])

        @foreach (var item in Model)
        {
            <a asp-controller="Users" asp-action="OrderInfo" asp-route-number="@item.orderDTO.OrderNum"
               class=" order-item d-block mb-3 bg-white p-3 rounded text-decoration-none">
                <span class="d-block w-100 mb-3 text-dark">訂單編號：<span
                    class=" text-green">@item.orderDTO.OrderNum</span></span>
                    <span class="text-grey-aaa ">
                        @item.orderDTO.OrderDetails.Count() 種品項
                    </span>
                    <sapn class="d-flex justify-content-between">
                        <span
                        class="text-grey-aaa me-3 d-inline-block fs-7">購買日期：@($"{item.orderDTO.OrderDate:yyyy/MM/dd}")</span>
                        <span class="text-grey-aaa">總計：<span class="text-danger">$@($"{item.TotalPrice:#,###.00}")</span></span>
                    </sapn>
                </a>
            }
        </div>
    </div>
