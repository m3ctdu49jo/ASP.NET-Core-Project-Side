@model IEnumerable<ShoppingCartDTO>

@{
    ViewData["Title"] = "購物車結帳";
}
@await Html.PartialAsync("Ordinary/_TitlePartial", ViewData["Title"])
@TempData["ErrorMessage"]

@await Html.PartialAsync("_CartItemsPartial", Model, new ViewDataDictionary(ViewData) {
    { "isBill", false}
})


@section Scripts {
    <script src="~/js/cart.js"></script>

    <script>
        checkoutCartInit();     
    </script>
}