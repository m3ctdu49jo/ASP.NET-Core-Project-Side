@model IEnumerable<ShoppingCartDTO>

@{
    ViewData["Title"] = "購物車結帳";
}
@await Html.PartialAsync("Ordinary/_TitlePartial", ViewData["Title"])
@TempData["ErrorMessage"]

@await Html.PartialAsync("_CartItemsPartial", Model)

<div class="d-flex justify-content-end mt-4">
    <button id="checkoutBtn" class="btn btn-warning">買單去</button>
</div>

@section Scripts {
    <script src="~/js/cart.js"></script>

    <script>
        checkoutCartInit();     
    </script>
}