@model RegisterUserViewModel
@{
    ViewData["Title"] = "註冊植感會員";
}

@await Html.PartialAsync("Ordinary/_TitlePartial", ViewData["Title"])
@if (ViewBag.ErrorMsg != null)
{
    <div style="color: red;">
        @ViewBag.ErrorMsg
    </div>
}
<form method="post" asp-action="Register" asp-controller="Login" class="d-flex flex-wrap gap-2">
    @Html.ValidationSummary(false, "", new { @class = "text-danger w-100" })

    <div class="d-flex gap-3 flex-wrap mb-4">
        <div class="w-100 fs-5 text-yellow fw-bold">帳號登入資訊</div>
        <div>
            *<label asp-for="UserInfo.UserName" class="me-2"></label>
            <styled-input type="text" asp-for="UserInfo.UserName" placeholder="" required=true></styled-input>
        </div>
        <div>
            *<label asp-for="UserInfo.Password" class="me-2"></label>
            <styled-input type="password" asp-for="UserInfo.Password" required=true></styled-input>
        </div>
        <div>
            *<label for="confirmPassword" class="me-2">確認密碼</label>
            <styled-input type="password" asp-for="ConfirmPassword" required=true></styled-input>
        </div>
    </div>
    <div class="d-flex gap-3 flex-wrap mb-4">
        <div class="w-100 fs-5 text-yellow fw-bold">個人資料</div>
        <div>
            *<label asp-for="UserInfo.Name" class="me-2"></label>
            <styled-input type="text" asp-for="UserInfo.Name" required=true></styled-input>
        </div>
        <div>
            <label asp-for="UserInfo.Email" class="me-2"></label>
            <styled-input type="email" asp-for="UserInfo.Email" placeholder=""></styled-input>
        </div>
        <div>
            <label asp-for="UserInfo.Phone" class="me-2"></label>
            <styled-input type="tel" asp-for="UserInfo.Phone"></styled-input>
        </div>
    </div>
    <div class="d-flex gap-3 flex-wrap mb-4">
        <div class="w-100 fs-5 text-yellow fw-bold">通訊地址</div>
        <div class="d-flex align-items-center">
            <label asp-for="UserInfo.City" class="me-2"></label>
            <select asp-for="UserInfo.City" asp-items="@Model.Cities"></select>
        </div>
        <div>
            <label asp-for="UserInfo.Address" class="me-2"></label>
            <styled-input type="text" asp-for="UserInfo.Address" style="width: 500px;"></styled-input>
        </div>
    </div>
    <div class="mb-2 w-100">
        <input type="submit" value="註冊" class="btn btn-primary" />
        <input type="reset" value="重設" class="btn btn-secondary" />
    </div>
</form>
