@model UserDTO
@{
    ViewData["Title"] = "會員登入";
}

<div class="d-flex gap-5 justify-content-around mt-5">
    <div class="d-flex justify-content-center align-items-center">
        <img src="~/images/login/banner.jpg" class="box-shadow-img w-100 border border-2 border-white"
             style="max-width: 450px; border-radius: 220px 0 180px 0;" />
    </div>
    <div>
        @await Html.PartialAsync("Ordinary/_TitlePartial", ViewData["Title"])
        <form method="post" asp-action="Index" asp-asp-controller="Login">
            <div class="d-inline-block text-end align-items-end">
                <div class="mb-4">
                    <label class="color-blue-3 me-2">@Html.DisplayNameFor(m => m.UserName)</label>
                    <styled-input type="text" asp-for="UserName"></styled-input>
                </div>
                <div class="mb-5">
                    <label class="color-blue-3 me-2">@Html.DisplayNameFor(m => m.Password)</label>
                    <styled-input type="password" asp-for="Password"></styled-input>
                </div>
                <a href="@Url.Action("ForgotPassword", "Login")"
                   class="btn btn-link text-decoration-none text-dark">忘記密碼？</a>
                <input id="registerBtn" type="button" class="btn btn-secondary me-1" value="註冊" />
                <input id="loginBtn" type="submit" class="btn btn-primary" value="登入" />
            </div>
        </form>

        <p>
            @if (ViewBag.ErrorMsg != null)
            {
                <span class="text-danger">@ViewBag.ErrorMsg</span>
            }
        </p>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("registerBtn").addEventListener("click", () => {
            window.location.href = "/Login/Register";
        });
    </script>
}

